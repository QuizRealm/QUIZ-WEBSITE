{
  "name": "quizrealm",
  "version": "3.0.0",
  "private": true,
  "description": "QuizRealm static games, publishing tools and regression checks",
  "scripts": {
    "dev": "node tools/serve.cjs",
    "check": "node tools/check-site.cjs && node tools/check-globals.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "build:css": "node tools/compile-css.cjs",
    "build": "node tools/build.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "acorn": "8.15.0",
    "eslint-scope": "9.1.2",
    "globals": "17.14.0",
    "sharp": "0.35.5",
    "sortablejs": "1.15.7",
    "tailwindcss": "3.4.19"
  }
}
